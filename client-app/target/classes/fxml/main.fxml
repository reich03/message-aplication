<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.messaging.client.controller.MainController">
   <top>
      <MenuBar BorderPane.alignment="CENTER">
         <menus>
            <Menu mnemonicParsing="false" text="Archivo">
               <items>
                  <MenuItem mnemonicParsing="false" onAction="#handleExit" text="Salir" />
               </items>
            </Menu>
            <Menu mnemonicParsing="false" text="Herramientas">
               <items>
                  <MenuItem mnemonicParsing="false" onAction="#handleSettings" text="Configuración" />
               </items>
            </Menu>
            <Menu mnemonicParsing="false" text="Ayuda">
               <items>
                  <MenuItem mnemonicParsing="false" onAction="#handleAbout" text="Acerca de" />
               </items>
            </Menu>
         </menus>
      </MenuBar>
   </top>
   <center>
      <StackPane>
         <!-- Panel de Login -->
         <VBox fx:id="loginPane" alignment="CENTER" spacing="20.0" styleClass="login-pane">
            <children>
               <Label styleClass="app-title" text="Sistema de Mensajería" />
               <VBox alignment="CENTER" spacing="10.0">
                  <children>
                     <TextField fx:id="usernameField" maxWidth="300.0" promptText="Nombre de usuario" />
                     <PasswordField fx:id="passwordField" maxWidth="300.0" promptText="Contraseña" />
                     <HBox alignment="CENTER" spacing="10.0">
                        <children>
                           <Button fx:id="loginButton" onAction="#handleLogin" text="Iniciar Sesión" />
                           <Button fx:id="registerButton" onAction="#handleRegister" text="Registrarse" />
                        </children>
                     </HBox>
                     <Label fx:id="loginStatusLabel" styleClass="status-label" />
                  </children>
               </VBox>
            </children>
         </VBox>
         
         <!-- Panel de Chat -->
         <VBox fx:id="chatPane" visible="false">
            <children>
               <!-- Barra superior -->
               <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="top-bar">
                  <children>
                     <Label fx:id="welcomeLabel" styleClass="welcome-label" />
                     <Region HBox.hgrow="ALWAYS" />
                     <Label fx:id="connectionStatusLabel" styleClass="connection-status" />
                  </children>
               </HBox>
               
               <!-- Contenido principal -->
               <SplitPane dividerPositions="0.3, 0.7" orientation="HORIZONTAL">
                  <items>
                     <!-- Panel izquierdo - Usuarios y mensajes -->
                     <VBox spacing="10.0">
                        <children>
                           <Label text="Usuarios Conectados" styleClass="section-title" />
                           <TableView fx:id="usersTable" prefHeight="200.0">
                              <columns>
                                 <TableColumn fx:id="usernameColumn" prefWidth="120.0" text="Usuario" />
                                 <TableColumn fx:id="statusColumn" prefWidth="100.0" text="Estado" />
                                 <TableColumn fx:id="lastSeenColumn" prefWidth="150.0" text="Última Conexión" />
                              </columns>
                           </TableView>
                           
                           <Label text="Mensajes (Master-Detail)" styleClass="section-title" />
                           <TableView fx:id="messagesTable" prefHeight="200.0">
                              <columns>
                                 <TableColumn fx:id="senderColumn" prefWidth="100.0" text="De" />
                                 <TableColumn fx:id="receiverColumn" prefWidth="100.0" text="Para" />
                                 <TableColumn fx:id="typeColumn" prefWidth="80.0" text="Tipo" />
                                 <TableColumn fx:id="contentColumn" prefWidth="200.0" text="Contenido" />
                                 <TableColumn fx:id="timestampColumn" prefWidth="120.0" text="Fecha/Hora" />
                              </columns>
                           </TableView>
                        </children>
                     </VBox>
                     
                     <!-- Panel derecho - Chat -->
                     <VBox spacing="10.0">
                        <children>
                           <Label fx:id="selectedUserLabel" styleClass="selected-user-label" text="Seleccione un usuario para chatear" />
                           
                           <!-- Área de mensajes -->
                           <ListView fx:id="messagesList" prefHeight="300.0" styleClass="messages-list" />
                           
                           <!-- Área de entrada -->
                           <VBox spacing="5.0">
                              <children>
                                 <TextArea fx:id="messageTextArea" prefRowCount="3" promptText="Escriba su mensaje aquí... (Ctrl+Enter para enviar)" />
                                 <HBox alignment="CENTER_RIGHT" spacing="10.0">
                                    <children>
                                       <Button fx:id="sendFileButton" onAction="#handleSendFile" text="📎 Enviar Archivo" />
                                       <Button fx:id="sendMessageButton" onAction="#handleSendMessage" text="Enviar Mensaje" />
                                    </children>
                                 </HBox>
                              </children>
                           </VBox>
                        </children>
                     </VBox>
                  </items>
               </SplitPane>
            </children>
         </VBox>
      </StackPane>
   </center>
   <bottom>
      <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="status-bar">
         <children>
            <Label text="Estado:" />
            <Label fx:id="statusLabel" text="Listo" />
            <Region HBox.hgrow="ALWAYS" />
            <Label text="Sistema de Mensajería v1.0" />
         </children>
      </HBox>
   </bottom>
</BorderPane>
